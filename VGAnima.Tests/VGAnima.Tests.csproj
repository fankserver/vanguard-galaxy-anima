<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VGAnima.Tests</RootNamespace>
    <!-- Referencing VGAnima.csproj transitively pulls BepInEx.Core etc. from
         nuget.bepinex.dev; the Microsoft.NET.Test.Sdk + xunit packages live on
         nuget.org. Include both so restore works from either direction. -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <!-- PatronContext surfaces SpaceStation (Unity MonoBehaviour subtype), so
         the CLR needs UnityEngine.* reference assemblies to JIT its ctor. -->
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.6" />
    <!-- VGAnima marks BepInEx.Core and HarmonyX IncludeAssets="compile" so their
         runtime assemblies don't ship in the deployed plugin — the game provides
         them. xUnit DOES need them at runtime (AnimaConfigTests creates
         ConfigFile; VgttsBridgeTests exercises BepInEx.Logging paths), so pull
         them in directly here to bypass the transitive-assets filter.
         BepInEx.Core is a meta-package; BepInEx.dll itself ships in BaseLib. -->
    <PackageReference Include="BepInEx.BaseLib" Version="5.*" />
    <PackageReference Include="HarmonyX" Version="2.10.*" />
    <!-- Newtonsoft.Json is also compile-only in VGAnima (game provides it), but
         xUnit needs it at runtime to exercise LlmRequestBodyTests + the parsing
         path in ResponseValidatorTests. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VGAnima\VGAnima.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private unstripped reference supplies real managed constructors/getters.
         Production still compiles against the stripped reference and never copies this DLL. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\.local-test-reference\Assembly-CSharp.dll</HintPath>
    </Reference>

    <!-- VGMissionJournal — the bridge exposes MissionRecord in its method
         signatures, so tests that touch the bridge transitively need the
         assembly resolvable at test-run time. Copy (not Private=false)
         because xUnit's AppDomain has no runtime plugin to shadow it. -->
    <Reference Include="VGMissionJournal">
      <HintPath>..\VGAnima\lib\VGMissionJournal.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
