<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VGAnima</AssemblyName>
    <Product>Vanguard Galaxy Anima</Product>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VGAnima</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
    <!-- BepInEx / HarmonyX / UnityEngine.Modules / Newtonsoft.Json are all marked
         IncludeAssets="compile" below so they stay out of bin — the game ships its
         own copies at runtime. We originally tried System.Text.Json here for the
         LLM JSON work, but Mono's TypeLoader VTable-faulted on Utf8JsonWriter
         (Unity 6000.2 Mono profile doesn't stomach STJ 8.x + its shipped
         System.Memory/Buffers variants). Switched to Newtonsoft.Json which Unity
         provides natively — one less copy-local concern, no version-conflict risk.
         CopyLocalLockFileAssemblies stays on so if a future dep genuinely needs
         to ship, bin/ will pick it up automatically. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.6" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.10.*" IncludeAssets="compile" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publicized stub of the game's Assembly-CSharp.dll. Symlinked from the VGTTS
         checkout (single source of truth) via `make link-asm`. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VGAnima.Tests" />
  </ItemGroup>

</Project>
